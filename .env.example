# Copy to .env and fill in. Restart the server after changes.
# The model string uses litellm naming: <provider>/<model>.

# Which model answers "Ask AI" and writes the one-click reports (default if unset: azure/gpt-4.1).
# For Azure, the part after "azure/" must be the deployment name configured in
# Azure AI Foundry, which may differ from the underlying model name.
VIEWER_LLM_MODEL=azure/gpt-4.1

# --- Azure OpenAI (for VIEWER_LLM_MODEL=azure/...) ---
AZURE_API_KEY=
AZURE_API_BASE=
# AZURE_API_VERSION=            # optional, litellm picks a default

# --- Anthropic (for VIEWER_LLM_MODEL=anthropic/..., e.g. anthropic/claude-sonnet-5) ---
# ANTHROPIC_API_KEY=

# --- OpenAI (for VIEWER_LLM_MODEL=gpt-... / openai/...) ---
# OPENAI_API_KEY=

# --- Google Gemini (for VIEWER_LLM_MODEL=gemini/...) ---
# GEMINI_API_KEY=

# --- Run storage ---
# Where runs are stored: an absolute path, or one relative to this repo (default: data). Tests started
# from the Run test page write their run straight into it (talk-bench --output-dir), so they are never
# copied or synced. Restart the viewer after changing it, and move the existing runs (and dotfiles) along.
VIEWER_DATA_DIR=data

# --- Source checkouts (optional) ---
# ai-ds-research checkouts that Sync sources and Run test use, ":"-separated
# (default: ~/GitHub/ai-ds-research, then ~/Documents/tau2-bench-fork/ai-ds-research)
# VIEWER_SOURCE_REPOS=
