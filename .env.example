# Copy to .env and fill in. Restart the server after changes.
# The model string uses litellm naming: <provider>/<model>.

# Set to true when sharing the viewer publicly. This blocks uploads, starring,
# and file replacement while keeping browse and AI chat access.
VIEWER_READ_ONLY=false

# Allow the local source-repository sync action in read-only shared mode.
# VIEWER_ALLOW_SYNC=true

# Optional: hide and block AI chat (including in read-only shared mode).
# VIEWER_DISABLE_CHAT=true

# Optional: hide the Run test page (launching talk-bench runs from the viewer).
# It is always disabled in read-only shared mode.
# VIEWER_DISABLE_TEST_RUNS=true

# Which model answers the per-scenario "Ask AI" chat (default if unset: azure/gpt-4.1).
# For Azure, the part after "azure/" must be the deployment name configured in
# Azure AI Foundry, which may differ from the underlying model name.
VIEWER_LLM_MODEL=azure/gpt-4.1

# --- Azure OpenAI (for VIEWER_LLM_MODEL=azure/...) ---
AZURE_API_KEY=
AZURE_API_BASE=
# AZURE_API_VERSION=            # optional, litellm picks a default

# --- Anthropic (for VIEWER_LLM_MODEL=anthropic/..., e.g. anthropic/claude-sonnet-5) ---
# ANTHROPIC_API_KEY=

# --- OpenAI (for VIEWER_LLM_MODEL=gpt-... / openai/...) ---
# OPENAI_API_KEY=

# --- Google Gemini (for VIEWER_LLM_MODEL=gemini/...) ---
# GEMINI_API_KEY=
